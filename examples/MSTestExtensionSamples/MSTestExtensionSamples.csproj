<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
    <TestingExtensionsProfile>None</TestingExtensionsProfile>
    <!-- Argument labels and native invocation context are absent from 4.4.1. -->
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(MSTestVersion)', '4.5.1'))">$(DefineConstants);MSTEST_ARGUMENT_LABELS;MSTEST_NATIVE_CONTEXT</DefineConstants>
  </PropertyGroup>
</Project>
